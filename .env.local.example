# Supabase connection — copy this file to `.env.local` and fill in real values.
# Find these in Supabase dashboard → your project → Settings → API.
# Do NOT commit `.env.local` (it is gitignored). In production, set these in
# Vercel → Settings → Environment Variables.

# Public — safe in the browser (protected by row-level security).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# SECRET — server-only. Never prefix with NEXT_PUBLIC. Required for coordinator
# email alerts, member deletions, and looking up coordinator emails.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Email alerts to coordinators (optional). Leave blank to disable email; the
# in-portal alerts still work. Uses Resend (https://resend.com).
#   RESEND_API_KEY   – from your Resend dashboard (starts with "re_").
#   ALERT_FROM_EMAIL – a verified Resend sender, e.g. "TELPSAM <alerts@yourdomain.org>".
#   NEXT_PUBLIC_APP_URL – your site's base URL, used for the link in the email.
RESEND_API_KEY=
ALERT_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=https://your-portal-url.com

# Set to "true" to show a "Test environment" banner across the whole site.
# Remove it (or set to anything else) for the real launch.
NEXT_PUBLIC_TEST_MODE=
